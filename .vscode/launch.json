        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE A500 512k Chip, 512k Slow - PAL",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/uae/dh0/main",
            "remoteProgram": "SYS:main",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s", "kickstart_rom_file=${workspaceFolder}/roms/kick1.3.rom",
                "-s", "chipset=ocs",
                "-s", "chipmem_size=1",
                "-s", "bogomem_size=2",
                "-s", "fastmem_size=0",
                "-s", "cpu_type=68000",
                "-s", "cpu_speed=real",
                "-s", "cpu_compatible=true",
                "-s", "cpu_cycle_exact=true",
                "-s", "cycle_exact=true",
                "-s", "cachesize=0",
                "-s", "warp=false",
                "-s", "turbo_boot=false",
                "-s", "ntsc=false",
                "-s", "gfx_framerate=1",
                "-s", "gfx_linemode=double",
                "-s", "sound_output=normal",
                "-s", "joyport0=mouse",
                "-s", "joyport1=joy0",
                "-s", "joyport1_mode=djoy",
                "-s", "filesystem=rw,dh0:${workspaceFolder}/uae/dh0"
            ],
            "preLaunchTask": "build + ADF"
        },
